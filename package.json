{
  "name": "meta-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only local MCP server for the Meta Graph / Marketing API (ForeachURL)",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "meta-mcp": "dist/src/index.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "smoke": "npm run build && node dist/scripts/smoke.js",
    "knowledge": "npm run build --silent && node dist/src/knowledge/bin.js",
    "publisher": "npm run build --silent && node dist/src/publisher/bin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "linkedom": "^0.18.13",
    "playwright-core": "1.63.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
