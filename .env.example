# Copy to .env and fill in locally. Never commit .env.
META_ACCESS_TOKEN=your-system-user-access-token
META_AD_ACCOUNT_ID=act_000000000000000
META_GRAPH_API_VERSION=v26.0
# Optional: set only after the Page is assigned to the System User and its ID is verified.
# META_PAGE_ID=000000000000000
# Optional: editorial store, must be an absolute path OUTSIDE this repository.
# Defaults to the sibling folder ../editorial.
# PUBLISHER_CONTENT_DIR=/absolute/path/to/editorial
# Website link registry (npm run knowledge). The knowledge repository must be
# OUTSIDE this public repo, the website repo and the editorial store.
# KNOWLEDGE_DIR=/absolute/path/to/knowledge   (default: sibling ../knowledge)
KNOWLEDGE_SITE_ORIGIN=https://example.com
# KNOWLEDGE_MIN_DELAY_MS=2000
# KNOWLEDGE_MAX_PAGES=100
# KNOWLEDGE_STALE_DAYS=14
# PORTFOLIO_DIR=/absolute/path/to/website-repo   (default: sibling ../portfolio)
# Paths verified on every crawl besides the sitemap (e.g. known aliases), comma-separated:
# KNOWLEDGE_EXTRA_PATHS=/alias
